#!/bin/bash -x

source ~/.env

if pgrep core3; then
    echo "** Already running **"
    exit 123
fi

cd $HOME/workspace/Core3/MMOCoreORB/bin

if [ -f "screenlog.0" ]; then
    for i in 5 4 3 2 1
    do
        let "j=$i-1"
        mv o_screenlog.${j}.gz o_screenlog.${i}.gz 2> /dev/null
        mv log/o_player.${j}.log.gz log/o_player.${i}.log.gz 2> /dev/null
    done

    mv screenlog.0 o_screenlog.0 2> /dev/null

    gzip -f o_screenlog.0 2> /dev/null
fi

(
    echo "$* $(date)"
    set -x
    if [ "X$1" = "Xclean" ]; then
        rm -f databases/*
        mysql swgemu -vvvvv -e "truncate characters; delete from accounts where username != 'admin';"
        mysql swgemu -vvvvv -e "alter table accounts alter admin_level set default 15;"
        find log -name \*.log | while read f
    do
        cp /dev/null $f
    done
    rm -fr navmeshes exports databases/navmesh.db
    mkdir navmeshes exports
    sleep 5
    fi

    mysql swgemu -vvvvv -e "update galaxy set address = '${GALAXY_ADDRESS}';select * from galaxy;"
    # SECURITY: the admin password must never appear in this process's argv
    # (visible to `ps` on the host via `docker top`/procfs for as long as
    # this mysql invocation runs) or be echoed back to stdout (captured by
    # `docker logs` via the "2>&1 | tee screenlog.0" below, and written into
    # screenlog.0 itself). Feed the statement over stdin instead of `-e`, and
    # drop `-vvvvv`: mysql only echoes back the statements it runs when `-v`
    # is passed, regardless of whether they came from `-e` or stdin, so `-e`
    # alone is not sufficient -- both must go. `set -x` (active above) stays
    # safe here: xtrace prints only the command name for a here-doc ("+ mysql
    # swgemu"), never the here-doc body.
    mysql swgemu <<SQL_ADMIN_RESET
update accounts set salt='', password=sha1('${ADMIN_PASS}') where username = 'admin';
SQL_ADMIN_RESET
) 2>&1 | tee screenlog.0

export ASAN_OPTIONS='atexit=1:stats=1:detect_stack_use_after_return=1'

screen -dmS swgemu-server -L -- gdb --quiet --command=~/bin/gdb_settings ${PWD}/core3

screen -D -RR swgemu-server
